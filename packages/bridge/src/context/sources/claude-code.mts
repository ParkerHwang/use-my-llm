/**
 * Read-only reader for Claude Code's local data.
 *
 *   <claudeHome>/projects/<project>/<session-id>.jsonl
 *   <claudeHome>/projects/<project>/memory/*.md      (auto memory, MEMORY.md first)
 *   <claudeHome>/CLAUDE.md, <project>/CLAUDE.md, <project>/.claude/CLAUDE.md
 *
 * Only user and assistant text blocks on the main thread are extracted.
 * Tool calls, tool results, thinking, attachments and sidechains are left out.
 */
import { realpathSync } from 'node:fs';
import { basename, dirname, extname, isAbsolute, join, relative, resolve, sep } from 'node:path';
import type { LoadedSource, SourceItem, SourceMessage } from '../types.mjs';
import {
  clip, containedPath, entries, fileMtime, fileSize, firstUserPrompt, isRecord, isoDate, jsonLines,
  previewOf, readHead, readTail, readText, text,
} from './util.mjs';

const MAX_ARTIFACT_BYTES = 64 * 1024;
const MAX_ARTIFACTS = 16;
const TEXT_EXTENSION = /^(?:\.(?:md|markdown|txt|json|jsonl|yaml|yml|toml|xml|csv|tsv|html|css|js|mjs|cjs|ts|mts|jsx|tsx|py|go|rs|java|kt|swift|c|cpp|h|sh|sql))$/i;
const PRIVATE_COMPONENT = /^(?:\..*|node_modules|vendor|.*(?:credential|secret|token|password|keychain).*|auth\.json)$/i;
// These are presentation preferences only. Never copy auth, account, projects,
// MCP, hook, environment, trust or permission configuration from this file.
const PREFERENCE_KEYS = ['theme', 'verbose', 'autoCompactEnabled', 'editorMode', 'language', 'outputStyle', 'model', 'effortLevel'] as const;

const SESSION_FILE = /^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$/;
const LOCAL_COMMAND = /^\s*<(?:command-name|command-message|command-args|local-command-stdout|local-command-stderr|local-command-caveat|bash-input|bash-stdout|bash-stderr|task-notification)\b|^\s*Caveat: The messages below were generated by the user while running local commands/;
const REMINDER = /<system-reminder>[\s\S]*?<\/system-reminder>/g;

export interface ClaudeCodeSourceOptions {
  claudeHome: string;
  detailLimit?: number;
  limit?: number;
}

export interface ParsedClaudeSession {
  id: string | null;
  cwd: string;
  title: string;
  date: string | null;
  messages: SourceMessage[];
}

function blockText(content: unknown): string {
  if (typeof content === 'string') return content;
  if (!Array.isArray(content)) return '';
  return content
    .flatMap((block) => isRecord(block) && block.type === 'text' && typeof block.text === 'string' ? [block.text] : [])
    .join('\n');
}

export function parseClaudeSession(raw: string): ParsedClaudeSession {
  const result: ParsedClaudeSession = { id: null, cwd: '', title: '', date: null, messages: [] };
  for (const line of jsonLines(raw)) {
    if (!isRecord(line)) continue;
    result.id ??= text(line.sessionId) || null;
    result.cwd ||= text(line.cwd);
    // Later title records win, as they do in the app.
    if (line.type === 'summary') result.title = text(line.summary) || result.title;
    if (line.type === 'custom-title') result.title = text(line.customTitle) || result.title;
    if (line.type === 'ai-title' && !result.title) result.title = text(line.aiTitle);
    if ((line.type !== 'user' && line.type !== 'assistant') || line.isSidechain === true || line.isMeta === true) continue;
    const message = isRecord(line.message) ? line.message : undefined;
    if (!message || message.role !== line.type) continue;
    if (line.isApiErrorMessage === true) continue;
    const body = blockText(message.content).replace(REMINDER, '').trim();
    if (!body || (line.type === 'user' && LOCAL_COMMAND.test(body))) continue;
    const timestamp = isoDate(line.timestamp) ?? undefined;
    result.date ??= timestamp ?? null;
    result.messages.push({ role: line.type, text: body, ...(timestamp && { timestamp }) });
  }
  return result;
}

function projectLabel(directoryName: string, cwd: string): string {
  return cwd || directoryName;
}

function textItem(ref: string, kind: 'memory' | 'instructions', project: string, path: string, title = basename(path)): SourceItem | null {
  if (fileSize(path) === null) return null;
  return {
    ref, app: 'claude-code', kind, project, title, date: null,
    firstPrompt: '', preview: clip(readHead(path, 4096) ?? '', 400),
  };
}

/** Only known display preferences may enter an approved snapshot. */
function preferences(claudeHome: string): string | null {
  const path = join(dirname(claudeHome), '.claude.json');
  if ((fileSize(path) ?? Infinity) > 1024 * 1024) return null;
  const raw = readText(path);
  if (!raw) return null;
  try {
    const value: unknown = JSON.parse(raw);
    if (!isRecord(value)) return null;
    const safe: Record<string, string | boolean> = {};
    for (const key of PREFERENCE_KEYS) {
      const entry = value[key];
      if (typeof entry === 'boolean' || (typeof entry === 'string' && entry.length <= 200)) safe[key] = entry;
    }
    return Object.keys(safe).length ? JSON.stringify(safe, null, 2) : null;
  } catch { return null; }
}

function readSession(path: string, claudeHome: string): { raw: string; parsed: ParsedClaudeSession } {
  const safe = containedPath(path, [join(claudeHome, 'projects')]);
  if (!SESSION_FILE.test(basename(safe))) throw new Error('Not a Claude Code session.');
  const raw = readText(safe);
  if (raw === null) throw new Error('This Claude Code session cannot be read.');
  return { raw, parsed: parseClaudeSession(raw) };
}

/** Tool inputs identify files; their commands and outputs never become context. */
function referencedFiles(raw: string, cwd: string): string[] {
  if (!isAbsolute(cwd)) return [];
  const paths = new Set<string>();
  const add = (value: unknown) => {
    if (typeof value !== 'string' || !value || value.includes('\0')) return;
    const path = resolve(cwd, value);
    paths.delete(path);
    paths.add(path);
  };
  for (const line of jsonLines(raw)) {
    if (!isRecord(line) || line.isSidechain === true || line.isMeta === true) continue;
    const message = isRecord(line.message) ? line.message : undefined;
    if (line.type !== 'assistant' || !Array.isArray(message?.content)) continue;
    for (const block of message.content) {
      if (!isRecord(block) || block.type !== 'tool_use' || !isRecord(block.input)) continue;
      if (['Read', 'Write', 'Edit', 'MultiEdit', 'NotebookEdit'].includes(text(block.name))) {
        add(block.input.file_path ?? block.input.path ?? block.input.notebook_path);
      }
    }
  }
  return [...paths].reverse();
}

function artifactPath(path: string, cwd: string): string {
  const safe = containedPath(path, [cwd]);
  const parts = [...relative(resolve(cwd), resolve(path)).split(sep), ...relative(realpathSync(cwd), safe).split(sep)];
  if (parts.some(part => PRIVATE_COMPONENT.test(part)) || !TEXT_EXTENSION.test(extname(safe)) ||
      (fileSize(safe) ?? Infinity) > MAX_ARTIFACT_BYTES) throw new Error('Not a shareable project text file.');
  return safe;
}

function workRef(kind: 'project' | 'artifact', session: string, path?: string): string {
  return `claude-code:${kind}:${Buffer.from(JSON.stringify([session, path])).toString('base64url')}`;
}

function projectText(cwd: string): string {
  if (!isAbsolute(cwd)) throw new Error('The project folder is unavailable.');
  const names = entries(cwd).filter(entry => !PRIVATE_COMPONENT.test(entry.name))
    .sort((a, b) => a.name.localeCompare(b.name)).slice(0, 100)
    .map(entry => `${entry.name}${entry.isDirectory() ? '/' : ''}`);
  return `Project folder: ${cwd}\nTop-level entries (names only, at most 100):\n${names.join('\n')}`;
}

export function listClaudeCode({ claudeHome, detailLimit = 40, limit = 300 }: ClaudeCodeSourceOptions): SourceItem[] {
  const projectsRoot = join(claudeHome, 'projects');
  const sessions: Array<{ path: string; project: string; mtimeMs: number }> = [];
  const memories: SourceItem[] = [];
  for (const project of entries(projectsRoot)) {
    if (!project.isDirectory()) continue;
    const directory = join(projectsRoot, project.name);
    for (const entry of entries(directory)) {
      const path = join(directory, entry.name);
      if (entry.isFile() && SESSION_FILE.test(entry.name)) {
        const size = fileSize(path);
        if (size) sessions.push({ path, project: project.name, mtimeMs: fileMtime(path) });
      }
    }
    const memoryRoot = join(directory, 'memory');
    const memoryFiles = entries(memoryRoot)
      .filter((entry) => entry.isFile() && entry.name.toLowerCase().endsWith('.md'))
      .map((entry) => entry.name)
      // The index first, then the individual memories.
      .sort((a, b) => Number(b === 'MEMORY.md') - Number(a === 'MEMORY.md') || a.localeCompare(b));
    for (const name of memoryFiles) {
      const path = join(memoryRoot, name);
      const item = textItem(`claude-code:memory:${path}`, 'memory', project.name, path);
      if (item) memories.push(item);
    }
  }

  const items: SourceItem[] = [];
  const projects = new Set<string>();
  const workProjects = new Set<string>();
  const workArtifacts = new Set<string>();
  sessions.sort((a, b) => b.mtimeMs - a.mtimeMs).slice(0, limit).forEach((session, index) => {
    let title = '';
    let project = session.project;
    let firstPrompt = '';
    let preview = '';
    let date: string | null = new Date(session.mtimeMs).toISOString();
    if (index < detailLimit) {
      const head = readHead(session.path);
      if (head !== null) {
        const parsed = parseClaudeSession(head);
        project = projectLabel(session.project, parsed.cwd);
        firstPrompt = clip(firstUserPrompt(parsed.messages), 200);
        preview = previewOf(parsed.messages);
        title = parsed.title;
        date = parsed.date ?? date;
        if (isAbsolute(parsed.cwd)) {
          projects.add(parsed.cwd);
          if (!workProjects.has(parsed.cwd) && entries(parsed.cwd).length) {
            workProjects.add(parsed.cwd);
            items.push({ ref: workRef('project', session.path), app: 'claude-code', kind: 'knowledge',
              project: parsed.cwd, title: 'Project folder (names only)', date: null, firstPrompt: '', preview: clip(projectText(parsed.cwd), 400) });
          }
          let count = 0;
          for (const candidate of referencedFiles(readTail(session.path) ?? head, parsed.cwd)) {
            try {
              const safe = artifactPath(candidate, parsed.cwd);
              if (workArtifacts.has(safe)) continue;
              const preview = readHead(safe, 4096);
              if (preview === null || preview.includes('\0')) continue;
              workArtifacts.add(safe);
              items.push({ ref: workRef('artifact', session.path, candidate), app: 'claude-code', kind: 'knowledge',
                project: parsed.cwd, title: relative(parsed.cwd, candidate), date: new Date(fileMtime(safe)).toISOString(),
                firstPrompt: '', preview: clip(preview, 400) });
              if (++count >= MAX_ARTIFACTS) break;
            } catch { /* Missing, private, oversized or outside the session's project. */ }
          }
        }
      }
    }
    items.push({
      ref: `claude-code:session:${session.path}`, app: 'claude-code', kind: 'session', project,
      title: title || (firstPrompt ? clip(firstPrompt, 80) : 'Claude Code conversation'),
      date, firstPrompt, preview, forkProvider: 'claude',
    });
  });
  items.push(...memories);

  const instructionFiles: Array<[project: string, path: string]> = [['Global', join(claudeHome, 'CLAUDE.md')]];
  for (const project of projects) {
    instructionFiles.push([project, join(project, 'CLAUDE.md')], [project, join(project, '.claude', 'CLAUDE.md')]);
  }
  for (const [project, path] of instructionFiles) {
    const item = textItem(`claude-code:instructions:${path}`, 'instructions', project, path);
    if (item) items.push(item);
  }
  const settings = preferences(claudeHome);
  if (settings) items.push({ ref: 'claude-code:preferences', app: 'claude-code', kind: 'instructions', project: 'Global preferences',
    title: 'Claude preferences (allowlisted)', date: null, firstPrompt: '', preview: clip(settings, 400) });
  return items;
}

export function loadClaudeCode(ref: string, { claudeHome }: ClaudeCodeSourceOptions): LoadedSource {
  const [, kind, ...rest] = ref.split(':');
  const requested = rest.join(':');
  const projectsRoot = join(claudeHome, 'projects');
  if (kind === 'preferences') {
    if (ref !== 'claude-code:preferences') throw new Error('Unknown Claude preferences.');
    const body = preferences(claudeHome);
    if (!body) throw new Error('No shareable Claude preferences.');
    return { item: { ref, app: 'claude-code', kind: 'instructions', project: 'Global preferences',
      title: 'Claude preferences (allowlisted)', date: null, firstPrompt: '', preview: clip(body, 400) }, text: body };
  }
  if (kind === 'project' || kind === 'artifact') {
    let descriptor: unknown;
    try { descriptor = JSON.parse(Buffer.from(requested, 'base64url').toString('utf8')); }
    catch { throw new Error('Invalid project reference.'); }
    if (!Array.isArray(descriptor) || descriptor.length !== 2 || typeof descriptor[0] !== 'string') throw new Error('Invalid project reference.');
    const { raw, parsed } = readSession(descriptor[0], claudeHome);
    let body: string;
    let title: string;
    if (kind === 'project') {
      if (descriptor[1] !== null) throw new Error('Invalid project reference.');
      body = projectText(parsed.cwd);
      title = 'Project folder (names only)';
    } else {
      const path: unknown = descriptor[1];
      if (typeof path !== 'string' || !referencedFiles(raw, parsed.cwd).includes(path)) throw new Error('This file was not referenced in this session.');
      const safe = artifactPath(path, parsed.cwd);
      const content = readText(safe);
      if (content === null || content.includes('\0') || Buffer.byteLength(content) > MAX_ARTIFACT_BYTES) throw new Error('This text file cannot be read.');
      title = relative(parsed.cwd, path);
      body = `Project file: ${title}\n\n${content}`;
    }
    return { item: { ref, app: 'claude-code', kind: 'knowledge', project: parsed.cwd, title,
      date: null, firstPrompt: '', preview: clip(body, 400) }, text: body };
  }
  if (kind === 'session') {
    const path = containedPath(requested, [projectsRoot]);
    const match = SESSION_FILE.exec(basename(path));
    const raw = match ? readText(path) : null;
    if (!match || raw === null) throw new Error('This Claude Code session cannot be read.');
    const parsed = parseClaudeSession(raw);
    const firstPrompt = clip(firstUserPrompt(parsed.messages), 200);
    return {
      item: {
        ref, app: 'claude-code', kind: 'session', project: parsed.cwd,
        title: parsed.title || clip(firstPrompt, 80) || 'Claude Code conversation',
        date: parsed.date, firstPrompt, preview: previewOf(parsed.messages), forkProvider: 'claude',
      },
      messages: parsed.messages,
      // The file name is the session id that `claude --resume` expects.
      fork: { provider: 'claude' },
    };
  }
  if (kind === 'memory' || kind === 'instructions') {
    let path: string;
    if (kind === 'memory') {
      path = containedPath(requested, [projectsRoot]);
      if (basename(join(path, '..')) !== 'memory') throw new Error('Not an auto memory file.');
    } else {
      if (!isAbsolute(requested) || requested.includes('\0') || basename(requested) !== 'CLAUDE.md') {
        throw new Error('Not a CLAUDE.md file.');
      }
      if (!listClaudeCode({ claudeHome }).some(item => item.kind === 'instructions' && item.ref === ref)) {
        throw new Error('This instruction file is not associated with a local Claude project.');
      }
      const root = requested === join(claudeHome, 'CLAUDE.md') ? claudeHome
        : basename(dirname(requested)) === '.claude' ? dirname(dirname(requested)) : dirname(requested);
      path = containedPath(requested, [root]);
    }
    if (!path.toLowerCase().endsWith('.md')) throw new Error('Not a Markdown file.');
    const body = readText(path);
    if (body === null) throw new Error('This file cannot be read.');
    return {
      item: {
        ref, app: 'claude-code', kind, project: '', title: basename(path), date: null,
        firstPrompt: '', preview: clip(body, 400),
      },
      text: body,
    };
  }
  throw new Error('Unknown Claude Code item.');
}
